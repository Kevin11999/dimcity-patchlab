{
  "name": "lk-veam-tool",
  "version": "0.3.0",
  "description": "DimCity PatchLab – LK/Veam patch en DimCity universe validator",
  "author": "Kevin van Setten",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.cjs && node --check renderer.js && node --check project-io.js && node --check csv-editor.js && node --check export-pdf.js && node --check ui/welcome.js && node --check ui/icons.js && node --check core/library.js && node --check ui/device-builder.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always",
    "manual": "node scripts/build-manual.mjs",
    "release-notes": "mkdir -p dist && node scripts/build-manual.mjs"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.dimcity.patchlab",
    "publish": [
      {
        "provider": "github",
        "owner": "Kevin11999",
        "repo": "dimcity-patchlab",
        "releaseType": "release"
      }
    ],
    "productName": "DimCity PatchLab",
    "files": [
      "main.js",
      "preload.cjs",
      "renderer.js",
      "project-io.js",
      "csv-editor.js",
      "export-pdf.js",
      "index.html",
      "styles/**",
      "ui/**",
      "core/**",
      "assets/**",
      "package.json",
      "library/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/dimcity-patchlab.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/dimcity-patchlab.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/dimcity-patchlab.png",
      "category": "Utility"
    },
    "fileAssociations": [
      {
        "ext": "lkproj",
        "name": "PatchLab Project",
        "role": "Editor"
      }
    ]
  }
}
