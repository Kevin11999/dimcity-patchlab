{
  "name": "lk-veam-tool",
  "version": "0.1.0",
  "description": "DimCity PatchLab – LK/Veam patch en DimCity universe validator",
  "author": "Kevin van Setten",
  "main": "main.js",
  "type": "module",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },

  "dependencies": {
    "papaparse": "^5.4.1"
  },

  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12"
  },

  "build": {
    "appId": "nl.dimcity.patchlab",
    "productName": "DimCity PatchLab",

    "files": [
      "main.js",
      "preload.cjs",
      "renderer.js",
      "project-io.js",
      "csv-editor.js",
      "export-pdf.js",
      "index.html",
      "assets/**",
      "package.json"
    ],

    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/dimcity-patchlab.icns"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/dimcity-patchlab.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/dimcity-patchlab.png",
      "category": "Utility"
    }
  }
}
